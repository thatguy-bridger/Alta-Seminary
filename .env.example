# Copy to .env and fill in from your Supabase project settings (Settings -> API).
# Both are safe to expose to the client — RLS is what actually protects data, not secrecy of these values.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: enables the Google Analytics snippet in BaseLayout when set.
PUBLIC_GA_MEASUREMENT_ID=

# The site's public address, no trailing slash. Set this to the real address once there is a custom domain; if it is missing the
# current address (https://alta-seminary-omega.vercel.app) is used. Used for canonical links, the sitemap and the feed.
PUBLIC_SITE_URL=<value>
