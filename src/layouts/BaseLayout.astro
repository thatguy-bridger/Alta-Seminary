---
import '../design-system/styles.css';
import { withBase } from '../lib/url.js';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title, description, ogImage, noindex = false,
  ogType = 'website', publishedTime, structuredData,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;

// Every page gets the site-wide Organization entry; a page can additionally
// pass its own structuredData prop (Event, Article, ...) which is appended
// as a second script tag rather than merged into one object -- JSON-LD
// supports multiple <script> blocks per page, and keeping them separate
// means this one never has to know the shape of every other page's schema.
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  name: 'Alta Seminary',
  url: Astro.site?.toString(),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="32x32" />
    <link rel="icon" type="image/png" sizes="16x16" href={withBase('/favicon-16x16.png')} />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon-32x32.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase('/apple-touch-icon.png')} />
    <meta name="generator" content={Astro.generator} />

    <title>{title} | Alta Seminary</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site)} />}
    <meta property="og:url" content={canonicalURL} />
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <link rel="alternate" type="application/rss+xml" title="Alta Seminary Announcements" href={new URL(withBase('/rss.xml'), Astro.site)} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}

    <!-- Loaded before the stylesheet so data-theme is set with no flash of the wrong theme -->
    <script is:inline src={withBase('/theme-init.js')}></script>

    {gaId && !noindex && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}
  </head>
  <body>
    <slot />
  </body>
</html>
