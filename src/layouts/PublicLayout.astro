---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import { BlockRenderer } from '../blocks/BlockRenderer.jsx';
import { getGlobalChromelessBlocks } from '../lib/pages.js';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, ogImage, ogType, publishedTime, structuredData } = Astro.props;
// Chromeless blocks (Background Music, Back to Top, Timed Popup, Site
// Effect, ...) flagged "Show on all pages" -- fetched once here so every
// public page that goes through this shared layout renders them, regardless
// of which specific page they're actually stored in (see getPublishedPage's
// own filtering-out of these, in lib/pages.js, so the one page storing it
// doesn't also render it a second time via its own block list).
const globalBlocks = await getGlobalChromelessBlocks();
---

<BaseLayout title={title} description={description} ogImage={ogImage} ogType={ogType} publishedTime={publishedTime} structuredData={structuredData}>
  <a href="#main-content" class="skip-link">Skip to content</a>
  <Header />
  <main class="site-main" id="main-content">
    <slot />
  </main>
  <Footer />
  {globalBlocks.length > 0 && <BlockRenderer blocks={globalBlocks} client:load />}
  <div id="not-found-toast" class="not-found-toast" role="status" hidden>
    <span class="not-found-toast__icon" aria-hidden="true">⚠</span>
    <span>That page doesn't exist — it may still be a work in progress. We brought you here instead.</span>
    <button type="button" aria-label="Dismiss">&times;</button>
  </div>
</BaseLayout>

<script>
  // Shown when 404.astro's "closest real page" fallback lands here -- see
  // the ?notfound=1 flag it sets before redirecting. Without this, a
  // visitor bounced to some other page has no idea why they're not looking
  // at what they actually clicked.
  const url = new URL(window.location.href);
  if (url.searchParams.get('notfound') === '1') {
    url.searchParams.delete('notfound');
    window.history.replaceState({}, '', url);

    const toast = document.getElementById('not-found-toast');
    if (toast) {
      toast.hidden = false;
      const dismiss = () => { toast.hidden = true; };
      toast.querySelector('button')?.addEventListener('click', dismiss);
      setTimeout(dismiss, 8000);
    }
  }
</script>

<style>
  .site-main {
    flex: 1;
    width: 100%;
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--space-8) var(--space-6);
    /* Lets the @container(max-width:640px) rules in components.css react to
       this box's own width -- see the comment there. */
    container-type: inline-size;
  }
  .skip-link {
    position: absolute;
    top: -100%;
    left: var(--space-4);
    z-index: 100;
    padding: var(--space-3) var(--space-5);
    background: var(--text-primary);
    color: var(--surface-card);
    font-family: var(--font-sans);
    font-weight: var(--fw-bold);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: top var(--duration-fast);
  }
  .skip-link:focus {
    top: var(--space-4);
  }
  /* Top-anchored and deliberately louder than a normal toast (this is
     telling a visitor they didn't land where they clicked, worth noticing) --
     warning-toned, bordered, and wider on desktop than the typical small
     bottom-corner notification. */
  .not-found-toast {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    position: fixed;
    top: var(--space-4);
    left: 50%;
    transform: translateX(-50%);
    z-index: 200;
    width: min(94vw, 640px);
    padding: var(--space-4) var(--space-5);
    background: var(--tint-warning-bg);
    color: var(--color-warning);
    border: 1px solid var(--color-warning);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    font-weight: var(--fw-bold);
  }
  .not-found-toast[hidden] {
    display: none;
  }
  .not-found-toast__icon {
    flex-shrink: 0;
    font-size: 1.3em;
  }
  .not-found-toast span:not(.not-found-toast__icon) {
    flex: 1;
  }
  .not-found-toast button {
    flex-shrink: 0;
    border: none;
    background: none;
    color: inherit;
    font-size: 1.3em;
    line-height: 1;
    cursor: pointer;
    opacity: 0.7;
  }
  .not-found-toast button:hover {
    opacity: 1;
  }
</style>
