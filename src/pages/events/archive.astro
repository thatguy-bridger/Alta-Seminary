---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { BlockRenderer } from '../../blocks/BlockRenderer.jsx';
import { resolveTeaserData } from '../../blocks/teaserData.js';
import { supabaseBuild } from '../../lib/supabase/build-client';
import { withBase } from '../../lib/url.js';

// Every event that's over, most recent first -- the "look back" half of the
// Events page. Each links to its own page, which keeps its details and photos.
// Built from the same Events block as the live list, set to its "past" mode.
const blocks = [
  { id: 'event-archive', type: 'events-teaser', props: { heading: '', count: 'all', timeframe: 'past' }, layout: { spacing: 'md' } },
];
const teaserData = await resolveTeaserData(blocks, supabaseBuild);
---

<PublicLayout title="Past events" description="A look back at past events, with their photos.">
  <header style="text-align:center; margin-bottom: var(--space-8);">
    <h1 style="font-family: var(--font-display); font-size: var(--fs-display); color: var(--text-primary); margin: 0 0 var(--space-2);">
      Past events
    </h1>
    <p style="font-family: var(--font-sans); color: var(--text-muted); margin: 0;">
      <a href={withBase('/events')} style="color: var(--text-link);">← Upcoming events</a>
    </p>
  </header>
  <BlockRenderer blocks={blocks} teaserData={teaserData} client:visible />
</PublicLayout>
