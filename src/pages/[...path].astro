---
// Catch-all for custom pages an admin creates via "+ New Page". Server-
// rendered per-request (see astro.config.mjs) -- Astro always prefers a
// more specific route file (about.astro, events.astro, ...) over this
// rest-parameter catch-all when both could match, so unlike the old
// build-time version, this no longer needs a RESERVED_PATHS list or
// getStaticPaths at all; it only ever runs for a path nothing else claimed.
import BuilderPage from '../components/site/BuilderPage.astro';
import { supabaseBuild } from '../lib/supabase/build-client';
import { findClosestRoute } from '../lib/pages.js';

const requestedPath = '/' + (Astro.params.path || '');
const { data } = await supabaseBuild
  .from('public_pages')
  .select('slug')
  .eq('route_path', requestedPath)
  .maybeSingle();

if (!data) {
  const closest = await findClosestRoute(requestedPath);
  return Astro.redirect(`${closest}?notfound=1`, 302);
}
---

<BuilderPage slug={data.slug} fallbackTitle="Page" />
