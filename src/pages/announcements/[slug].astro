---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { BlockRenderer } from '../../blocks/BlockRenderer.jsx';
import { resolveTeaserData } from '../../blocks/teaserData.js';
import { supabaseBuild } from '../../lib/supabase/build-client';
import { findClosestRoute } from '../../lib/pages.js';

// Server-rendered per-request (see astro.config.mjs) -- no getStaticPaths,
// Astro.params is populated straight from the incoming request URL.
const { slug } = Astro.params;
const { data: post } = await supabaseBuild
  .from('public_blog_posts')
  .select('title, excerpt, cover_image_url, published_blocks, published_at')
  .eq('slug', slug)
  .maybeSingle();

if (!post) {
  const closest = await findClosestRoute(`/announcements/${slug}`);
  return Astro.redirect(`${closest}?notfound=1`, 302);
}

const blocks = post.published_blocks || [];
const teaserData = await resolveTeaserData(blocks, supabaseBuild);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.excerpt || undefined,
  image: post.cover_image_url || undefined,
  datePublished: post.published_at || undefined,
};
---

<PublicLayout
  title={post.title}
  description={post.excerpt}
  ogImage={post.cover_image_url}
  ogType="article"
  publishedTime={post.published_at}
  structuredData={articleSchema}
>
  <header style="text-align:center; margin-bottom: var(--space-8);">
    <h1 style="font-family: var(--font-display); font-size: var(--fs-display); color: var(--text-primary); margin: 0 0 var(--space-2);">
      {post.title}
    </h1>
    {post.published_at && (
      <p style="font-family: var(--font-sans); font-size: var(--fs-small); color: var(--text-muted); margin: 0;">
        {new Date(post.published_at).toLocaleDateString(undefined, { month: 'long', day: 'numeric', year: 'numeric' })}
      </p>
    )}
  </header>
  {blocks.length > 0 && <BlockRenderer blocks={blocks} teaserData={teaserData} client:visible />}
</PublicLayout>
