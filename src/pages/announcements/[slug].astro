---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { BlockRenderer } from '../../blocks/BlockRenderer.jsx';
import { resolveTeaserData } from '../../blocks/teaserData.js';
import { supabaseBuild } from '../../lib/supabase/build-client';
import { withBase } from '../../lib/url.js';

export async function getStaticPaths() {
  const { data } = await supabaseBuild.from('public_blog_posts').select('slug');
  return (data || []).map((post) => ({ params: { slug: post.slug } }));
}

const { slug } = Astro.params;
const { data: post } = await supabaseBuild
  .from('public_blog_posts')
  .select('title, excerpt, cover_image_url, published_blocks, published_at')
  .eq('slug', slug)
  .maybeSingle();

const blocks = post?.published_blocks || [];
const teaserData = await resolveTeaserData(blocks, supabaseBuild);

const { data: recentPosts } = post
  ? await supabaseBuild
      .from('public_blog_posts')
      .select('slug, title, published_at')
      .neq('slug', slug)
      .order('published_at', { ascending: false })
      .limit(3)
  : { data: null };

const articleSchema = post ? {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.excerpt || undefined,
  image: post.cover_image_url || undefined,
  datePublished: post.published_at || undefined,
} : undefined;
---

<PublicLayout
  title={post?.title || 'Announcement'}
  description={post?.excerpt}
  ogImage={post?.cover_image_url}
  ogType="article"
  publishedTime={post?.published_at}
  structuredData={articleSchema}
>
  {post ? (
    <>
      <header style="text-align:center; margin-bottom: var(--space-8);">
        <h1 style="font-family: var(--font-display); font-size: var(--fs-display); color: var(--text-primary); margin: 0 0 var(--space-2);">
          {post.title}
        </h1>
        {post.published_at && (
          <p style="font-family: var(--font-sans); font-size: var(--fs-small); color: var(--text-muted); margin: 0;">
            {new Date(post.published_at).toLocaleDateString(undefined, { month: 'long', day: 'numeric', year: 'numeric' })}
          </p>
        )}
      </header>
      {blocks.length > 0 && <BlockRenderer blocks={blocks} teaserData={teaserData} client:visible />}

      {recentPosts && recentPosts.length > 0 && (
        <nav aria-label="More announcements" style="margin-top: var(--space-16); padding-top: var(--space-8); border-top: 1px solid var(--border-subtle);">
          <h2 style="font-family: var(--font-display); font-size: var(--fs-subheading); color: var(--text-primary); margin: 0 0 var(--space-4); text-align: center;">
            More Announcements
          </h2>
          <ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-2); max-width: 560px; margin-inline: auto;">
            {recentPosts.map((p) => (
              <li>
                <a href={withBase(`/announcements/${p.slug}`)} style="display: flex; justify-content: space-between; gap: var(--space-3); padding: var(--space-3); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); text-decoration: none; color: var(--text-primary); font-family: var(--font-sans); font-weight: var(--fw-bold);">
                  <span>{p.title}</span>
                  {p.published_at && (
                    <span style="color: var(--text-muted); font-weight: var(--fw-regular); white-space: nowrap;">
                      {new Date(p.published_at).toLocaleDateString(undefined, { month: 'short', day: 'numeric' })}
                    </span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </>
  ) : (
    <p style="color:var(--text-muted); text-align:center; padding: var(--space-16) 0;">
      This announcement couldn't be found.
    </p>
  )}
</PublicLayout>
