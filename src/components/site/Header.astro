---
import { Image } from 'astro:assets';
import Nav from './Nav.astro';
import { ThemeToggle } from '../../design-system/components/core/ThemeToggle.jsx';
import { TextSizeToggle } from '../../design-system/components/core/TextSizeToggle.jsx';
import { SiteSearch } from './SiteSearch.jsx';
import logo from '../../assets/alta-seminary-logo.png';
import { withBase } from '../../lib/url.js';
import { getSiteChrome } from '../../lib/pages.js';
const { header } = await getSiteChrome();
---

{header.bannerOn && (
  <div class="site-banner">
    {header.bannerUrl ? <a href={header.bannerUrl.startsWith('/') ? withBase(header.bannerUrl) : header.bannerUrl}>{header.bannerText}</a> : header.bannerText}
  </div>
)}
<header class="site-header">
  <div style="display: flex; align-items: center; gap: var(--space-3);">
    <a href={withBase('/')} class="site-header__wordmark">
      {header.logoUrl
        ? <img src={header.logoUrl} alt={header.logoAlt} height="40" />
        : <Image src={logo} alt={header.logoAlt} height={40} />}
    </a>
    {header.showSearch && <SiteSearch client:idle />}
  </div>
  <Nav />
  {/* margin-left: auto (not the header's own justify-content: space-between,
      removed below) -- with 3 flex children, space-between stretched a gap
      between the MIDDLE one (Nav) and this group regardless of how narrow
      Nav actually was, so once Nav collapsed to just its hamburger button
      (see Nav.astro), that gap turned into a huge, obviously-broken-looking
      dead zone. flex-start + auto-margin on just this last group keeps the
      logo/search/nav cluster together on the left and pushes only this
      group flush right, with no awkward middle gap at any nav width. */}
  <div style="display: flex; align-items: center; gap: var(--space-3); margin-left: auto;">
    {header.showTextSize && <TextSizeToggle client:idle />}
    {header.showThemeToggle && <ThemeToggle client:idle />}
  </div>
</header>

<style>
  .site-banner {
    padding: var(--space-2) var(--space-6);
    text-align: center;
    background: var(--brand-secondary);
    color: var(--text-on-secondary);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    font-weight: var(--fw-bold);
  }
  .site-banner a { color: inherit; text-decoration: underline; }
  .site-header {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-4) var(--space-6);
    border-bottom: 1px solid var(--border-subtle);
    background: var(--surface-card);
    flex-wrap: wrap;
  }
  .site-header__wordmark {
    display: inline-flex;
    align-items: center;
  }
  .site-header__wordmark img {
    display: block;
    width: auto;
  }
</style>
