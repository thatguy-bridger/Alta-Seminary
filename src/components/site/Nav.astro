---
import { getNavTree } from '../../lib/pages.js';

interface NavLink {
  label: string;
  href?: string;
  children: NavLink[];
}

const links: NavLink[] = await getNavTree();
const currentPath = Astro.url.pathname;
---

<nav class="site-nav" aria-label="Main navigation" id="site-nav">
  {/* Hidden by default (components below), shown only once the script
      below measures the list wrapping to more than 2 rows -- see
      measure() -- so a page count that fits fine never shows a hamburger
      at all, on any viewport width. */}
  <button
    type="button"
    class="site-nav__toggle"
    id="site-nav-toggle"
    aria-expanded="false"
    aria-controls="site-nav-list"
    aria-label="Toggle menu"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" width="20" height="20">
      <line x1="4" y1="7" x2="20" y2="7"></line><line x1="4" y1="12" x2="20" y2="12"></line><line x1="4" y1="17" x2="20" y2="17"></line>
    </svg>
  </button>
  <ul class="site-nav__list" id="site-nav-list">
    {links.map((link) => (
      <li class="site-nav__item">
        {link.children.length > 0 ? (
          <details class="site-nav__dropdown">
            <summary>
              <span class="site-nav__label">{link.label}</span>
              <span class="site-nav__count" aria-hidden="true">{link.children.length}</span>
              <svg class="site-nav__chev" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </summary>
            <ul>
              {link.children.map((child) => (
                <li>
                  <a href={child.href} aria-current={currentPath === child.href ? 'page' : undefined}>
                    {child.label}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ) : (
          <a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>
            {link.label}
          </a>
        )}
      </li>
    ))}
  </ul>
</nav>

<style>
  .site-nav__list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    align-items: center;
  }
  .site-nav__item > a {
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    font-weight: var(--fw-bold);
    color: var(--text-secondary);
    text-decoration: none;
    padding: var(--space-2) 0;
    border-bottom: 2px solid transparent;
    transition: color var(--duration-fast), border-color var(--duration-fast);
  }
  .site-nav__item > a:hover,
  .site-nav__item > a[aria-current='page'] {
    color: var(--text-primary);
    border-bottom-color: var(--brand-secondary);
  }
  .site-nav__item > a:focus-visible,
  .site-nav__dropdown summary:focus-visible,
  .site-nav__dropdown ul a:focus-visible {
    outline: 2px solid var(--brand-secondary);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }
  .site-nav__dropdown {
    position: relative;
    font-family: var(--font-sans);
  }
  .site-nav__dropdown summary {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: var(--fs-small);
    font-weight: var(--fw-bold);
    color: var(--text-secondary);
    cursor: pointer;
    list-style: none;
  }
  .site-nav__dropdown summary::-webkit-details-marker {
    display: none;
  }
  /* A small arrow on everything that has pages under it, turning over when it is open. */
  .site-nav__chev { transition: transform var(--duration-fast); flex-shrink: 0; }
  .site-nav__dropdown[open] > summary .site-nav__chev { transform: rotate(180deg); }
  .site-nav__count { display: none; }
  .site-nav__dropdown summary:hover {
    color: var(--text-primary);
  }
  .site-nav__dropdown ul {
    list-style: none;
    margin: var(--space-2) 0 0;
    padding: var(--space-2);
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 160px;
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    z-index: 20;
  }
  .site-nav__dropdown[open] ul {
    animation: glide-in 900ms cubic-bezier(0.22, 0.61, 0.36, 1) both;
  }
  @media (prefers-reduced-motion: reduce) {
    .site-nav__dropdown[open] ul { animation: none; }
  }
  .site-nav__dropdown ul a {
    display: block;
    padding: var(--space-2) var(--space-3);
    font-size: var(--fs-small);
    color: var(--text-primary);
    text-decoration: none;
    border-radius: var(--radius-sm);
  }
  .site-nav__dropdown ul a:hover {
    background: var(--surface-sunken);
  }

  /* Collapsed state: only ever applied by the script below, once the list
     ACTUALLY wraps past 2 rows at the current viewport width -- there's no
     fixed breakpoint here, since whether that happens depends on how many
     pages exist, not just screen size. */
  .site-nav {
    position: relative;
  }
  .site-nav__toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--brand-secondary);
    border-radius: var(--radius-md);
    background: var(--brand-secondary);
    color: var(--text-on-secondary);
    cursor: pointer;
  }
  .site-nav__toggle:hover {
    background: var(--brand-secondary-hover);
    border-color: var(--brand-secondary-hover);
  }
  .site-nav.is-collapsed .site-nav__toggle {
    display: flex;
  }
  .site-nav.is-collapsed .site-nav__list {
    display: none;
  }
  .site-nav.is-collapsed.is-open .site-nav__list {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-1);
    position: absolute;
    top: 100%;
    right: 0;
    margin-top: var(--space-2);
    min-width: 220px;
    max-height: 70vh;
    overflow-y: auto;
    padding: var(--space-3);
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    z-index: 30;
  }
  .site-nav.is-collapsed.is-open .site-nav__item {
    width: 100%;
  }
  .site-nav.is-collapsed.is-open .site-nav__dropdown ul {
    position: static;
    box-shadow: none;
    border: none;
    border-left: 2px solid var(--border-default);   /* a guide line down the pages that belong to the heading above */
    border-radius: 0;
    background: transparent;
    margin: 2px 0 var(--space-2) var(--space-4);
    padding: 0 0 0 var(--space-2);
    animation: none;
  }
  .site-nav.is-collapsed.is-open .site-nav__dropdown ul a {
    padding: var(--space-2) var(--space-3);
  }
  /* The menu itself: a roomier, rounder panel. A heading with pages under it reads as a heading (bold, a count, an arrow at the
     far end); a plain page is just a row. */
  .site-nav.is-collapsed.is-open .site-nav__list {
    min-width: 260px;
    padding: var(--space-2);
    gap: 2px;
    border-radius: var(--radius-lg, 14px);
  }
  .site-nav.is-collapsed.is-open .site-nav__dropdown summary {
    display: flex;
    justify-content: space-between;
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    background: var(--surface-sunken);
  }
  .site-nav.is-collapsed.is-open .site-nav__dropdown summary .site-nav__label { margin-right: auto; }
  .site-nav.is-collapsed.is-open .site-nav__count {
    display: inline-block;
    min-width: 20px;
    padding: 0 6px;
    border-radius: var(--radius-pill);
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    color: var(--text-secondary);
    font-size: var(--fs-caption);
    line-height: 18px;
    text-align: center;
  }
  /* The default underline (border-bottom on the anchor, sized to hug just
     its own text) looks fine inline in the desktop bar, where every link
     sits at the same baseline -- but stacked vertically here, two
     different-length labels ("Home" vs "Announcements") produce two
     visibly different-length underlines with no shared alignment, which
     reads as broken rather than as "these are both the current/hovered
     link." A full-width block with a left accent bar instead gives every
     row the exact same indicator regardless of label length. */
  .site-nav.is-collapsed.is-open .site-nav__item > a,
  .site-nav.is-collapsed.is-open .site-nav__dropdown summary {
    display: block;
    width: 100%;
    box-sizing: border-box;
    padding: var(--space-2) var(--space-3);
    border-bottom: none;
    border-left: 3px solid transparent;
  }
  .site-nav.is-collapsed.is-open .site-nav__item > a:hover,
  .site-nav.is-collapsed.is-open .site-nav__item > a[aria-current='page'] {
    border-bottom: none;
    border-left-color: var(--brand-secondary);
    background: var(--surface-sunken);
  }
  /* The open menu hangs from the whole header (not from the button, which sits beside the logo and can be nowhere near the right
     edge of a phone), with a gutter either side and never wider than the screen, so no part of it can fall off the edge. */
  .site-nav.is-collapsed { position: static; }
  .site-nav.is-collapsed.is-open .site-nav__list {
    left: auto;
    right: var(--space-4);
    min-width: 0;
    width: min(320px, calc(100vw - 2 * var(--space-4)));
    box-sizing: border-box;
    margin-top: 0;
  }
</style>

<script>
  // Counts actual rendered rows (grouping list items by their offsetTop,
  // since `flex-wrap` never tells you directly how many lines it wrapped
  // to) rather than assuming a fixed viewport breakpoint -- the number of
  // nav links is admin-controlled and varies site to site, so "does this
  // wrap past 2 rows" genuinely depends on both viewport width AND how many
  // pages currently show in the nav, not just one or the other.
  function measure() {
    const nav = document.getElementById('site-nav');
    const list = document.getElementById('site-nav-list');
    if (!nav || !list) return;
    nav.classList.remove('is-collapsed', 'is-open');
    const rowTops = new Set(Array.from(list.children).map((el) => (el instanceof HTMLElement ? el.offsetTop : 0)));
    if (rowTops.size > 2) nav.classList.add('is-collapsed');
  }

  function toggleOpen() {
    const nav = document.getElementById('site-nav');
    const toggle = document.getElementById('site-nav-toggle');
    if (!nav || !toggle) return;
    const open = nav.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(open));
    // Open with the pages under every heading showing, so it is clear there are pages there to choose from.
    if (open) nav.querySelectorAll('details.site-nav__dropdown').forEach((d) => { (d as HTMLDetailsElement).open = true; });
  }

  function closeOnOutsideClick(e: MouseEvent) {
    const nav = document.getElementById('site-nav');
    if (nav && nav.classList.contains('is-open') && !nav.contains(e.target as Node)) {
      nav.classList.remove('is-open');
      document.getElementById('site-nav-toggle')?.setAttribute('aria-expanded', 'false');
    }
  }

  document.getElementById('site-nav-toggle')?.addEventListener('click', toggleOpen);
  document.addEventListener('click', closeOnOutsideClick);
  window.addEventListener('resize', measure);
  // Astro's view-transitions swap (if ever enabled) fire this instead of a
  // real load -- measure() is cheap enough to just run on both.
  document.addEventListener('astro:page-load', measure);
  measure();
</script>
