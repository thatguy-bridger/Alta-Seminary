---
import { withBase } from '../../lib/url.js';
import { getSiteChrome } from '../../lib/pages.js';
import { footerText } from '../../lib/siteChrome.js';
const year = new Date().getFullYear();
const { footer } = await getSiteChrome();
const href = (u: string) => (u.startsWith('/') ? withBase(u) : u);
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <p class="site-footer__legal">{footerText(footer.text, year)}</p>
      {footer.about && <p class="site-footer__about">{footer.about}</p>}
    </div>
    <div class="site-footer__cols">
      <section>
        <h2>Quick links</h2>
        <ul>
          {footer.links.map((l: { label: string; url: string }) => <li><a href={href(l.url)}>{l.label}</a></li>)}
        </ul>
      </section>
      {footer.social.length > 0 && (
        <section>
          <h2>Follow us</h2>
          <ul>
            {footer.social.map((l: { label: string; url: string }) => <li><a href={href(l.url)} rel="noopener">{l.label}</a></li>)}
          </ul>
        </section>
      )}
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-16);
    /* Extra bottom room so the floating back-to-top button never sits on top of footer text. */
    padding: var(--space-10, 2.5rem) var(--space-6) var(--space-16);
    border-top: 1px solid var(--border-subtle);
    background: var(--surface-sunken);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    color: var(--text-secondary);
  }
  /* Same width and side padding as the page content (.site-main), so the
     footer lines up with everything above it instead of floating inset. */
  .site-footer__inner {
    max-width: var(--content-max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-8, 2rem);
    align-items: start;
  }
  .site-footer__brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 40rem;
  }
  /* The link columns become direct grid cells next to the text block. */
  .site-footer__cols { display: contents; }
  @media (max-width: 720px) {
    .site-footer__inner { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .site-footer__brand { grid-column: 1 / -1; }
  }
  .site-footer h2 {
    margin: 0 0 var(--space-3);
    font-size: var(--fs-caption);
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-primary);
  }
  .site-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .site-footer p { margin: 0; }
  .site-footer__about { white-space: pre-line; line-height: 1.6; }
  .site-footer a {
    color: var(--text-secondary);
    text-decoration: none;
  }
  .site-footer a:hover {
    color: var(--text-link);
    text-decoration: underline;
  }
  .site-footer__legal {
    font-size: var(--fs-small);
    color: var(--text-secondary);
    line-height: 1.6;
  }
</style>
