---
import { withBase } from '../../lib/url.js';
import { getSiteChrome } from '../../lib/pages.js';
import { footerText, socialInfo } from '../../lib/siteChrome.js';
import { pickFooterIcon } from '../../lib/footerIcons.js';
const year = new Date().getFullYear();
const { footer } = await getSiteChrome();
const href = (u: string) => (u.startsWith('/') ? withBase(u) : u);
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <p class="site-footer__legal">{footerText(footer.text, year)}</p>
      {footer.about && <p class="site-footer__about">{footer.about}</p>}
    </div>
    <div class="site-footer__cols">
      <section>
        <h2>Quick links</h2>
        <ul>
          {footer.links.map((l: { label: string; url: string; icon?: string }) => {
            const pick = pickFooterIcon({ icon: '', ...l }, 'link');
            return (
              <li>
                <a href={href(l.url)} class={`site-footer__social${pick ? '' : ' site-footer__social--plain'}`}>
                  {pick?.type === 'svg' && (
                    <span class="site-footer__chip" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">{pick.icon?.paths.map((d: string) => <path d={d} />)}</svg>
                    </span>
                  )}
                  {l.label}
                </a>
              </li>
            );
          })}
        </ul>
      </section>
      {footer.social.length > 0 && (
        <section>
          <h2>Follow us</h2>
          <ul>
            {footer.social.map((l: { label: string; url: string; icon?: string }) => {
              const info = socialInfo(l.url);
              const pick = pickFooterIcon({ icon: '', ...l }, 'social', info);
              return (
                <li>
                  <a href={href(l.url)} rel="noopener" class={`site-footer__social${pick ? '' : ' site-footer__social--plain'}`}>
                    {pick?.type === 'favicon' && <img src={`https://www.google.com/s2/favicons?domain=${pick.domain}&sz=64`} alt="" width="32" height="32" loading="lazy" />}
                    {pick?.type === 'svg' && (
                      <span class="site-footer__chip" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">{pick.icon?.paths.map((d: string) => <path d={d} />)}</svg>
                      </span>
                    )}
                    {l.label || info?.name || l.url}
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      )}
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-12, 3rem);
    padding: var(--space-6) var(--space-6);
    border-top: 1px solid var(--border-subtle);
    background: var(--surface-sunken);
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    color: var(--text-secondary);
  }
  /* Same width and side padding as the page content (.site-main), so the
     footer lines up with everything above it. Right padding keeps the
     floating back-to-top button off the links. */
  .site-footer__inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding-right: 3.5rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4) var(--space-8, 2rem);
  }
  .site-footer__brand {
    flex: 1 1 18rem;
    max-width: 36rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  /* Both groups sit in one row; the pills inside wrap side by side. */
  .site-footer__cols {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-6);
  }
  .site-footer__cols section {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }
  @media (max-width: 720px) {
    .site-footer__inner { padding-right: 0; }
    .site-footer { padding-bottom: 4.5rem; }
  }
  .site-footer h2 {
    margin: 0;
    font-size: var(--fs-small);
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-primary);
  }
  .site-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .site-footer p { margin: 0; }
  .site-footer__about { white-space: pre-line; line-height: 1.6; }
  .site-footer a {
    color: var(--text-secondary);
    text-decoration: none;
  }
  .site-footer a:hover {
    color: var(--text-link);
    text-decoration: underline;
  }
  .site-footer__legal {
    font-size: var(--fs-body);
    color: var(--text-secondary);
    line-height: 1.6;
  }
  .site-footer__social {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-4) var(--space-2) var(--space-2);
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    background: var(--surface-card);
    color: var(--text-primary);
    line-height: 1.2;
  }
  .site-footer__social--plain { padding: var(--space-2) var(--space-4); }
  .site-footer__social:hover { text-decoration: none; border-color: var(--brand-secondary); color: var(--text-primary); }
  .site-footer__social img { width: 32px; height: 32px; border-radius: 50%; background: #fff; padding: 3px; box-sizing: border-box; flex-shrink: 0; }
  .site-footer__chip {
    width: 32px; height: 32px; border-radius: 50%; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    background: #fff; color: #26272b;
  }
  .site-footer li { display: flex; }
</style>
