---
import { withBase } from '../../lib/url.js';
import { getSiteChrome } from '../../lib/pages.js';
import { footerText } from '../../lib/siteChrome.js';
const year = new Date().getFullYear();
const { footer } = await getSiteChrome();
const href = (u: string) => (u.startsWith('/') ? withBase(u) : u);
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__cols">
      {footer.about && (
        <section>
          <h2>Contact</h2>
          <p class="site-footer__about">{footer.about}</p>
        </section>
      )}
      <section>
        <h2>Quick links</h2>
        <ul>
          {footer.links.map((l: { label: string; url: string }) => <li><a href={href(l.url)}>{l.label}</a></li>)}
        </ul>
      </section>
      {footer.social.length > 0 && (
        <section>
          <h2>Follow us</h2>
          <ul>
            {footer.social.map((l: { label: string; url: string }) => <li><a href={href(l.url)} rel="noopener">{l.label}</a></li>)}
          </ul>
        </section>
      )}
    </div>
    <p class="site-footer__legal">{footerText(footer.text, year)}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-16);
    /* Extra bottom room so the floating back-to-top button never sits on top of footer text. */
    padding: var(--space-10, 2.5rem) var(--space-6) var(--space-16);
    border-top: 1px solid var(--border-subtle);
    background: var(--surface-sunken);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    color: var(--text-secondary);
  }
  .site-footer__inner {
    max-width: 72rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-8, 2rem);
  }
  .site-footer__cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-8, 2rem) var(--space-10, 2.5rem);
  }
  .site-footer h2 {
    margin: 0 0 var(--space-3);
    font-size: var(--fs-caption);
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-primary);
  }
  .site-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .site-footer p { margin: 0; }
  .site-footer__about { white-space: pre-line; line-height: 1.6; }
  .site-footer a {
    color: var(--text-secondary);
    text-decoration: none;
  }
  .site-footer a:hover {
    color: var(--text-link);
    text-decoration: underline;
  }
  .site-footer__legal {
    padding-top: var(--space-5);
    border-top: 1px solid var(--border-subtle);
    font-size: var(--fs-caption);
    color: var(--text-muted);
    line-height: 1.5;
  }
</style>
